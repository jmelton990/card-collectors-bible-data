# build_index.dart's output -- published to GitHub Pages by the CI
# workflow, never committed to this repo's own history (that's what
# GitHub Pages' "deploy from Actions artifact" does under the hood
# instead of a checked-in gh-pages branch).
/dist/

.dart_tool/
.packages
pubspec.lock
